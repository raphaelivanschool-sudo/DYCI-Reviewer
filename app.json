{
  "expo": {
    "name": "METAKNOWIA",
    "slug": "metaknowia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metanoia",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.metanoia.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.metanoia.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "reminders",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "METAKNOWIA uses your photos to read your notes and class schedule.",
          "cameraPermission": "METAKNOWIA uses the camera to scan your notes and class schedule.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "METAKNOWIA saves your schedule image to your photos.",
          "savePhotosPermission": "METAKNOWIA saves your schedule image to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "METAKNOWIA uses Face ID so you can unlock the app quickly."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8e39cfc9-4d10-4a8b-9e80-64efd2ca5503"
      }
    },
    "owner": "notsowkewls-team"
  }
}
