# Copy this file to .env and fill in the values from:
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# mock = practice AI on the phone (free, no key). functions = real AI through Cloud Functions.
EXPO_PUBLIC_AI_MODE=gemini
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash

# Local testing with the Firebase Emulator Suite (npx firebase emulators:start)
EXPO_PUBLIC_USE_EMULATORS=false
# 10.0.2.2 for the Android emulator, or your computer's Wi-Fi IP for a real phone
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=